# ==============================================================================
# SLA Monitoring Dashboard - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your Supabase project credentials below.
# 3. If left blank, the app will automatically run on the built-in local SQLite DB.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Required for serverless batch operations & migrations)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
